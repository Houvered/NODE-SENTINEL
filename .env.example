# NODE SENTINEL Environment Configuration
# Copy this file to .env and configure secret keys before production deployment

# Application Settings
PROJECT_NAME="NODE SENTINEL"

# Security & Authentication
# Generate a secure 256-bit random key in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_key_in_production
AUTH_TOKEN_EXPIRE_MINUTES=480

# File Paths (Defaults to sample_data directory)
# USERS_FILE=/path/to/users.json
# AUDIT_FILE=/path/to/audit_log.json

# CORS Configuration
CORS_ORIGINS=*

# Case platform (evidence store, retention, upload policy)
# DATA_DIR=./data
# CASES_DB=./data/cases.db
# MAX_UPLOAD_MB=25
# MAX_DATASET_ROWS=20000
# ALLOW_PUBLIC_REGISTER=false
# RETENTION_DAYS=365
# MALWARE_SCAN_CMD=
# SECRET_KEY / AUTH_TOKEN_EXPIRE_MINUTES / USERS_FILE / AUDIT_FILE documented above
